[Unit]
Description=Matrix live US-index fund subscription information
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/Matrix
EnvironmentFile=-/opt/Matrix/.env
ExecStart=/opt/Matrix/scripts/run_funds.sh
TimeoutStartSec=5min
Nice=15
MemoryMax=192M
MemorySwapMax=64M
